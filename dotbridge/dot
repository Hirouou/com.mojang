#!/usr/bin/env python3
"""Atalho do cliente DotBridge; usa o perfil salvo por install.py."""
from __future__ import annotations

import importlib.util
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from install import InstallError, read_local_settings


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    try:
        settings = read_local_settings(ROOT)
    except InstallError as error:
        print(f"Erro: {error}", file=sys.stderr)
        return 1
    spec = importlib.util.spec_from_file_location("_dotbridge_cli", ROOT / "client" / "dotbridge.py")
    if spec is None or spec.loader is None:
        print("Erro: cliente DotBridge não encontrado nesta distribuição.", file=sys.stderr)
        return 1
    client = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(client)
    globals_ = []
    if settings:
        globals_ = ["--game-dir", settings["game_dir"], "--url", settings["url"]]
    return client.main(globals_ + args)


if __name__ == "__main__":
    raise SystemExit(main())
